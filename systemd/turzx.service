# Template only - 'turzx service install' writes the real unit with the
# correct Python interpreter and source path to ~/.config/systemd/user/.
[Unit]
Description=TURZX USB display (theme player)
After=default.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/env turzx daemon
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
